Cell["\<\
I want to be able to standardize the puzzle pieces entered by the user so \
that they are adjacent to the origin, which is accomplished as follows. \
\>", "Text",
 CellChangeTimes->{{3.944491638177258*^9, 3.944491708960497*^9}, {
  3.94449180285339*^9, 3.9444918055232143`*^9}, {3.9444931697397766`*^9, 
  3.9444931915650234`*^9}},
 CellID->759552517,ExpressionUUID->"b84a7122-67bf-9c41-86ba-4efd1d311503"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "moveToOrigin", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"moveToOrigin", "[", "piece_List", "]"}], ":=", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"minX", ",", "minY", ",", "minZ"}], "}"}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"minX", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "piece"}], "]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"minY", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "piece"}], "]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"minZ", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "&"}], "/@", "piece"}], "]"}]}], 
     ";", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "-", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minX", "-", "1"}], ",", 
           RowBox[{"minY", "-", "1"}], ",", 
           RowBox[{"minZ", "-", "1"}]}], "}"}]}], ")"}], "&"}], "/@", 
      "piece"}]}]}], "]"}]}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.9322464504012127`*^9, 3.932246703658236*^9}, {
  3.932247105923732*^9, 3.932247120631199*^9}, {3.9322471680805407`*^9, 
  3.932247168482373*^9}, {3.9322472321565304`*^9, 3.932247234935297*^9}, {
  3.9322473108204327`*^9, 3.932247330311003*^9}, {3.932247386436222*^9, 
  3.932247426287924*^9}, {3.9329127039273853`*^9, 3.9329127155066338`*^9}, {
  3.944510003353258*^9, 3.9445100536817417`*^9}},
 CellLabel->"In[57]:=",
 CellID->31441560,ExpressionUUID->"99b985f3-7b7b-e240-a0c2-51b2419dc53d"],

Cell["\<\
The following function takes a piece that has been standardized to be \
adjacent to the origin and determines every possible placement of that piece \
within the empty cube with size equal to the completed puzzle size. This is \
needed in order to create the occupancy matrix as explained in the \
\[OpenCurlyDoubleQuote]Representation as an Exact Cover Problem\
\[CloseCurlyDoubleQuote] section. \
\>", "Text",
 CellChangeTimes->{{3.944491871648011*^9, 3.944491958283804*^9}, {
  3.944491991783882*^9, 3.944492006333563*^9}, {3.94449204358231*^9, 
  3.94449205829508*^9}, {3.944516240629322*^9, 3.9445162429555254`*^9}},
 CellID->306394849,ExpressionUUID->"3aecac5f-c5d3-324f-b466-b408546152ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "findAllPiecePositions", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"findAllPiecePositions", "[", 
    RowBox[{"piece_List", ",", "cubeSize_Integer"}], "]"}], ":=", "\n", "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pieceSize", ",", "rotationsAtOrigin", ",", "pieceAtOrigin", ",", 
       "sizeDiff", ",", "allPositions"}], "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"pieceAtOrigin", "=", 
       RowBox[{"moveToOrigin", "[", "piece", "]"}]}], ";", "\n", "\t", 
      RowBox[{"rotationsAtOrigin", "=", 
       RowBox[{"moveToOrigin", "/@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"rotatePiece", "[", 
             RowBox[{"pieceAtOrigin", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "6"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}]}], 
      ";", "\n", "\t", 
      RowBox[{"pieceSize", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Max", "[", "#", "]"}], "-", " ", 
            RowBox[{"Min", "[", "#", "]"}], "+", "1"}], ")"}], "&"}], ",", 
         RowBox[{"Transpose", "/@", "rotationsAtOrigin"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"sizeDiff", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cubeSize", "-", "#", "+", "1"}], ")"}], "&"}], "/@", 
        "pieceSize"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"allPositions", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#1", "+", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "-", "1"}], ",", 
                   RowBox[{"y", "-", "1"}], ",", 
                   RowBox[{"z", "-", "1"}]}], "}"}]}], "&"}], "/@", "#1"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"sizeDiff", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"First", "[", "#2", "]"}], ",", "1"}], "]"}], 
                 "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"sizeDiff", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"First", "[", "#2", "]"}], ",", "2"}], "]"}], 
                 "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"z", ",", 
                RowBox[{"sizeDiff", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"First", "[", "#2", "]"}], ",", "3"}], "]"}], 
                 "]"}]}], "}"}]}], "]"}], "&"}], ",", "rotationsAtOrigin"}], 
          "]"}], ",", "3"}], "]"}]}], ";", "\n", "\t", "allPositions"}]}], 
    "]"}]}], ";"}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.932245640588045*^9, 3.9322457466326923`*^9}, {

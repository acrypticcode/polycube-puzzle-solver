Cell["\<\
The variable \[Gamma] represents the reduction in the unique number of piece \
orientations caused by symmetry. It must be true that \[Gamma] is a factor of \
24. \
\>", "Text",
 CellChangeTimes->{{3.944486903240234*^9, 3.944486940336474*^9}, {
  3.9444869879892883`*^9, 3.944487019652479*^9}, {3.944487061373085*^9, 
  3.944487196155187*^9}, {3.9444875648048954`*^9, 3.9444876249234314`*^9}, {
  3.944489010442324*^9, 3.944489012821873*^9}},
 CellID->443140511,ExpressionUUID->"def0f6a3-10cc-374f-ac9c-f1f52dfcb3d1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Building a Polycube Puzzle Solver", "Section",
 CellChangeTimes->{{3.9444061620996513`*^9, 3.944406223534788*^9}, 
   3.9444065444528084`*^9, {3.944497278163325*^9, 3.944497307919688*^9}},

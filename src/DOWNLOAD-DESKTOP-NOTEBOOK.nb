   3.932889529579906*^9}, {3.932889639975746*^9, 3.932889641205942*^9}, {
   3.9328911301179047`*^9, 3.932891131190918*^9}, {3.932895567743488*^9, 
   3.9328956060014*^9}, {3.932895763306141*^9, 3.932895773751196*^9}, {
   3.94399036586446*^9, 3.943990374106097*^9}, {3.943990446947098*^9, 
   3.9439904570737095`*^9}, {3.943991752675934*^9, 3.943991763340954*^9}, {
   3.944214128152949*^9, 3.944214152109909*^9}, {3.9442141915395546`*^9, 
   3.944214208405376*^9}, {3.944216407249849*^9, 3.944216436623337*^9}, {
   3.944233320710995*^9, 3.944233391106341*^9}, {3.944233734965349*^9, 
   3.944233816027375*^9}, {3.944233942465349*^9, 3.944233971752735*^9}, {

Cell["A GUI is created to receive input and display output. ", "Text",
 CellChangeTimes->{{3.94449511837299*^9, 3.944495135848663*^9}, {
  3.944495378637408*^9, 3.944495436174028*^9}},
 CellID->108269576,ExpressionUUID->"725b9804-0589-8246-b1c9-0cf157e07e06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solverGUI", "=", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cubeSize", "=", "3"}], ",", 
       RowBox[{"pieces", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"currentPiece", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"False", ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "5", ",", "5"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"pieceGraphics", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"solutionGraphic", "=", "Nothing"}], ",", "\n", 
       RowBox[{"solution2DGraphic", "=", "Nothing"}], ",", 
       RowBox[{"colors", "=", 
        RowBox[{"ColorData", "[", "97", "]"}]}]}], "}"}], ",", "\n", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"(*", 
         RowBox[{"Cube", " ", "size", " ", "selection"}], "*)"}], 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Cube Size: \>\"", ",", 
            RowBox[{"SetterBar", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "cubeSize", "]"}], ",", 
              RowBox[{"Range", "[", 
               RowBox[{"3", ",", "5"}], "]"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "3", "x3x3", " ", "grid", " ", "for", " ", "piece", " ", 
           "creation"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Pane", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "\n", 
            RowBox[{"Grid", "[", 
             RowBox[{"{", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Grid", "[", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"i", "=", "i"}], ",", 
                    RowBox[{"j", "=", "j"}], ",", 
                    RowBox[{"k", "=", "k"}]}], "}"}], ",", 
                    RowBox[{"Toggler", "[", 
                    RowBox[{
                    RowBox[{"Dynamic", "[", 
                    RowBox[{"currentPiece", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "j", ",", "i"}], "]"}], "]"}], "]"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"False", "->", "Gray"}], ",", 
                    RowBox[{"True", "->", "Yellow"}]}], "}"}], ",", 
                    RowBox[{"ContentPadding", "->", "False"}]}], "]"}]}], 
                    "]"}], ",", "\n", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "cubeSize"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "cubeSize"}], "}"}]}], "]"}], ",", 
                  RowBox[{"Spacings", "->", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}]}], ",", 
                  RowBox[{"ItemSize", "->", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "cubeSize"}], "}"}]}], "]"}], "}"}], "]"}],
             "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"400", ",", "75"}], "}"}], ",", 
           RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Submit", " ", "piece", " ", "button"}], "*)"}], 
         RowBox[{"Button", "[", 
          RowBox[{"\"\<Submit Piece\>\"", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"Or", "@@", 
              RowBox[{"Flatten", "[", "currentPiece", "]"}]}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"pieces", ",", "currentPiece"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"pieceGraphics", ",", 
                RowBox[{"Graphics3D", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Opacity", "[", "0.8", "]"}], ",", 
                    RowBox[{"colors", "[", 
                    RowBox[{"Length", "[", "pieces", "]"}], "]"}], ",", 
                    RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#1", "==", "True"}], ",", 
                    RowBox[{"Cube", "[", 
                    RowBox[{
                    RowBox[{"Reverse", "[", "#2", "]"}], "-", 
                    RowBox[{"1", "/", "2"}]}], "]"}], ",", "Nothing"}], "]"}],
                     "&"}], ",", "\n", "currentPiece", ",", 
                    RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}], ",", 
                  RowBox[{"ImageSize", "->", "Tiny"}]}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"currentPiece", "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"False", ",", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", "5", ",", "5"}], "}"}]}], "]"}]}]}]}], 
            "]"}], ",", 
           RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", "\n", 
         RowBox[{"(*", 
          RowBox[{"Display", " ", "created", " ", "pieces"}], "*)"}], 
         RowBox[{"Dynamic", "[", 
          RowBox[{"Row", "[", 
           RowBox[{"pieceGraphics", ",", 
            RowBox[{"Spacer", "[", "10", "]"}]}], "]"}], "]"}], ",", "\n", 
         RowBox[{"(*", " ", 
          RowBox[{"Solve", " ", "button"}], " ", "*)"}], "\n", 
         RowBox[{"Button", "[", 
          RowBox[{"\"\<Solve Puzzle\>\"", ",", "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "pieces", "]"}], " ", ">", " ", "0"}], 
             ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Check", " ", "if", " ", "there", " ", "are", " ", "pieces", 
               " ", "to", " ", "solve"}], " ", "*)"}], "\n", "    ", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", "solution", "}"}], ",", "\n", "      ", 
               RowBox[{
                RowBox[{"solution", " ", "=", " ", 
                 RowBox[{"solvePuzzle", "[", 
                  RowBox[{"pieces", ",", " ", "cubeSize"}], "]"}]}], ";", 
                "\n", "      ", "\n", "      ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  RowBox[{
                  "If", " ", "no", " ", "solution", " ", "is", " ", "found"}],
                   ",", " ", 
                  RowBox[{
                  "solution", " ", "will", " ", "be", " ", "an", " ", "empty",
                    " ", "list"}]}], " ", "*)"}], "\n", "      ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"solution", " ", "===", " ", 
                   RowBox[{"{", "}"}]}], ",", "\n", "        ", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{"If", " ", "no", " ", "solution", " ", "exists"}],
                     ",", " ", 
                    RowBox[{
                    "clear", " ", "the", " ", "graphics", " ", "and", " ", 
                    "give", " ", "feedback"}]}], " ", "*)"}], "\n", 
                  "        ", 
                  RowBox[{
                   RowBox[{"solutionGraphic", " ", "=", " ", "Nothing"}], ";",
                    "\n", "        ", 
                   RowBox[{"solution2DGraphic", " ", "=", " ", "Nothing"}], 
                   ";", "\n", "        ", 
                   RowBox[{
                   "MessageDialog", "[", 
                    "\"\<No solution exists for the provided pieces and cube \
size.\>\"", "]"}]}], ",", " ", 
                  RowBox[{"(*", " ", 
                   RowBox[{"Exit", " ", "if", " ", "no", " ", "solution"}], 
                   " ", "*)"}], "\n", "        ", "\n", "        ", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "Process", " ", "and", " ", "display", " ", "the", " ", 
                    "solution", " ", "if", " ", "one", " ", "is", " ", 
                    "found"}], " ", "*)"}], "\n", "        ", 
                  RowBox[{
                   RowBox[{"solutionGraphic", " ", "=", " ", 
                    RowBox[{"Graphics3D", "[", "\n", "          ", 
                    RowBox[{
                    RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#1", " ", "==", " ", "n"}], ",", " ", 
                    RowBox[{"Cube", "[", 
                    RowBox[{
                    RowBox[{"Reverse", "[", "#2", "]"}], " ", "-", " ", 
                    RowBox[{"1", " ", "/", " ", "2"}]}], "]"}], ",", " ", 
                    "Nothing"}], "]"}], " ", "&"}], ",", " ", "solution", ",",
                     " ", 
                    RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", 
                    RowBox[{"colors", "[", "n", "]"}]}], "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"{", 
                    RowBox[{"n", ",", " ", 
                    RowBox[{"Length", "[", "pieces", "]"}]}], "}"}]}], "]"}], 
                    ",", " ", 
                    RowBox[{"EdgeForm", "[", "None", "]"}]}], "]"}], ",", 
                    "\n", "          ", 
                    RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "\n", 
                    "        ", "]"}]}], ";", "\n", "        ", "\n", 
                   "        ", 
                   RowBox[{"solution2DGraphic", " ", "=", " ", 
                    RowBox[{"Column", "[", 
                    RowBox[{"Table", "[", "\n", "          ", 
                    RowBox[{
                    RowBox[{"Graphics", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Table", "[", "\n", "            ", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Rectangle", "[", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", " ", "j"}], "}"}], "]"}], ",", " ", 
                    RowBox[{"colors", "[", 
                    RowBox[{"solution", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"cubeSize", "-", "k", "+", "1"}], ",", " ", "j", 
                    ",", " ", "i"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", " ", "cubeSize"}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "cubeSize"}], "}"}]}], "]"}], 
                    "]"}], "]"}], ",", "\n", "          ", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", " ", "cubeSize"}], "}"}]}], "]"}], 
                    "]"}]}], ";"}]}], "\n", "      ", "]"}]}]}], "\n", "    ",
               "]"}], ",", "\n", "    ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"If", " ", "no", " ", "pieces", " ", "exist"}], ",", 
               " ", 
               RowBox[{"do", " ", "nothing"}]}], " ", "*)"}], "\n", "    ", 
             "Null"}], "\n", "  ", "]"}], ",", "\n", "  ", 
           RowBox[{"ImageSize", " ", "->", " ", "Small"}], ",", "\n", "  ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "\n", 
          "]"}], ",", "\n", 
         RowBox[{"Dynamic", "[", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"solutionGraphic", ",", " ", "solution2DGraphic"}], "}"}],
            "]"}], "]"}], ",", 
         RowBox[{"Button", "[", 
          RowBox[{"\"\<Reset and Start Over\>\"", ",", 
           RowBox[{
            RowBox[{"cubeSize", "=", "3"}], ";", "\n", 
            RowBox[{"pieces", "=", 
             RowBox[{"{", "}"}]}], ";", "\n", 
            RowBox[{"currentPiece", "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"False", ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "5", ",", "5"}], "}"}]}], "]"}]}], ";", 
            "\n", 
            RowBox[{"pieceGraphics", "=", 
             RowBox[{"{", "}"}]}], ";", "\n", 
            RowBox[{"solutionGraphic", "=", "Nothing"}], ";", "\n", 
            RowBox[{"solution2DGraphic", "=", "Nothing"}]}], ",", 
           RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "}"}], ",", 
       "Center"}], "]"}]}], "]"}]}], ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{
  3.932941200749138*^9, {3.932941241531372*^9, 3.932941288294945*^9}, {
   3.932941373928465*^9, 3.932941383203481*^9}, {3.9329415385613346`*^9, 

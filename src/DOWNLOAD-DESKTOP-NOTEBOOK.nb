Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", " ", "solvePuzzle"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solvePuzzle", "[", 
    RowBox[{"webInput_List", ",", "cubeSize_Integer"}], "]"}], ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pieceCount", ",", "coordList", ",", "rawSolution", ",", 
       "reducedSolution", ",", "oneHotSolution", ",", "flatSolution", ",", 
       "nestedSolution", ",", "ocMat"}], "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"pieceCount", "=", 
       RowBox[{"Length", "[", "webInput", "]"}]}], ";", "\n", "\t", 
      RowBox[{"coordList", "=", 
       RowBox[{"webInputToCoords", "[", 
        RowBox[{"webInput", ",", "cubeSize"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"ocMat", " ", "=", " ", 
       RowBox[{"createOccupancyMatrix", "[", 
        RowBox[{"coordList", ",", "cubeSize"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"rawSolution", "=", 
       RowBox[{"findExactCover", "[", "ocMat", "]"}]}], ";", "\n", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "rawSolution", "]"}], " ", "==", " ", "0"}], 
        ",", "\n", "\t\t", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"No", " ", "solution", " ", "found"}], ",", " ", 
          RowBox[{"so", " ", "return", " ", "empty", " ", "list"}]}], "*)"}], 
        "\n", "\t\t", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Return", " ", "an", " ", "empty", " ", "solution", " ", "in", " ", 
          "case", " ", "of", " ", "failure"}], " ", "*)"}], "\n", "\t\t", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Process", " ", "the", " ", "solution", " ", "if", " ", "one", " ", 
          "is", " ", "found"}], " ", "*)"}], "\n", "\t\t", 
        RowBox[{
         RowBox[{"reducedSolution", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"#", ",", " ", "pieceCount"}], "]"}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"SortBy", "[", 
            RowBox[{"rawSolution", ",", " ", 
             RowBox[{
              RowBox[{"FirstPosition", "[", 
               RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}]}], "]"}]}]}], 
         ";", "\n", "\t\t", 
         RowBox[{"oneHotSolution", " ", "=", " ", 
          RowBox[{"Transpose", "[", "reducedSolution", "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{"flatSolution", " ", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"FirstPosition", "[", 
              RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ",
             "oneHotSolution"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{"nestedSolution", " ", "=", " ", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"flatSolution", ",", " ", "cubeSize"}], "]"}], ",", " ", 
            "cubeSize"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{"(*", " ", 
          RowBox[{"Return", " ", "the", " ", "nested", " ", "solution"}], " ",
           "*)"}], "\n", "\t\t", "nestedSolution"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.932585574758093*^9, 3.932585607535856*^9}, {
   3.932585681999138*^9, 3.9325856887368164`*^9}, {3.932585739353756*^9, 
   3.9325857432905865`*^9}, {3.932585930531853*^9, 3.932585953841728*^9}, {

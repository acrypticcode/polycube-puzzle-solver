Cell["\<\
The createOccupancyList function creates a single row of the occupancy \
matrix, not including the one-hot vector at the beginning of the row that \
specifies which piece the row belongs to. \
\>", "Text",
 CellChangeTimes->{{3.9444924651021214`*^9, 3.944492534669641*^9}, {
  3.9444926029499626`*^9, 3.944492608178079*^9}},
 CellID->88968120,ExpressionUUID->"c915905e-3edb-ac4d-83b4-5993c249b995"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "createOccupancyList", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"createOccupancyList", "[", 
    RowBox[{"position_List", ",", "cubeSize_Integer"}], "]"}], ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "occupancyList", "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"occupancyList", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"cubeSize", ",", "cubeSize", ",", "cubeSize"}], "}"}]}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"occupancyList", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}], 
         ")"}], "&"}], "/@", "position"}], ";", "\n", "\t", 
      RowBox[{"Flatten", "[", "occupancyList", "]"}]}]}], "]"}]}], 
  ";"}]}], "Code",
 InitializationCell->False,

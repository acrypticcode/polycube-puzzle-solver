Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "webInputToCoords", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"webInputToCoords", "[", 
    RowBox[{"pieceMatrix_List", ",", "cubeSize_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "reversedCoords", "}"}], ",", 
     RowBox[{
      RowBox[{"reversedCoords", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"#", ",", "True"}], "]"}], "&"}], ",", "pieceMatrix"}], 
        "]"}]}], ";", 
      RowBox[{"Map", "[", 
       RowBox[{"Reverse", ",", "reversedCoords", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Code",
 InitializationCell->False,
